# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.nyc_output
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Project specific
/postgres/

# Prisma
/src/generated/
*.db
*.db-journal

# IDEs
/.idea
/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
*.swp
*.swo
*~

# Cache
.cache
.parcel-cache
.eslintcache
.stylelintcache
# Temporal
*.tmp
*.temp
# Sensitive
*.key
*.cert
*.crt
*.csr
*.p12
*.pfx
secrets.json
credentials.json
